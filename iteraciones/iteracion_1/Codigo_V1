#include <SoftwareSerial.h>
#include <string.h>

// SoftwareSerial: primero RX, luego TX
// SIM800L TXD -> Arduino D10
// Arduino D11 -> SIM800L RXD, con adaptacion de nivel
SoftwareSerial sim800(10, 11);

const int SENSOR_GAS = A0;
const int LED_ALERTA = 7;

// Elige tu num a poner
const char NUMERO_TELEFONO[] = "+56912345678";

// Valor ajustable
const int UMBRAL_ACTIVACION = 160;
const int UMBRAL_REARME = 140;

const unsigned long CALENTAMIENTO_INICIAL = 60000UL;
const unsigned long TIEMPO_REARME = 30000UL;
const unsigned long INTERVALO_REINTENTO = 60000UL;

bool alarmaActiva = false;
bool contandoNormal = false;
bool smsConfirmado = false;
bool huboIntentoSMS = false;

unsigned long inicioNormal = 0;
unsigned long ultimoIntentoSMS = 0;

void vaciarEntradaSIM() {
  while (sim800.available() > 0) {
    (void)sim800.read();
  }
}

bool esperarRespuesta(const char* token,
                      unsigned long timeoutMs) {
  char respuesta[120];
  size_t usados = 0;
  respuesta[0] = '\0';

  unsigned long inicio = millis();

  while (millis() - inicio < timeoutMs) {
    while (sim800.available() > 0) {
      char c = (char)sim800.read();
      Serial.write(c);

      if (usados < sizeof(respuesta) - 1) {
        respuesta[usados++] = c;
      } else {
        memmove(respuesta, respuesta + 1,
                sizeof(respuesta) - 2);
        usados = sizeof(respuesta) - 2;
        respuesta[usados++] = c;
      }

      respuesta[usados] = '\0';

      if (strstr(respuesta, token) != NULL) {
        return true;
      }

      if (strstr(respuesta, "ERROR") != NULL) {
        return false;
      }
    }
  }

  return false;
}

bool comandoOK(const char* comando,
               unsigned long timeoutMs = 4000UL) {
  // Evita confundir respuestas viejas con la nueva.
  vaciarEntradaSIM();
  sim800.println(comando);
  return esperarRespuesta("OK", timeoutMs);
}

bool enviarSMS() {
  Serial.println(F("Preparando SMS..."));

  if (!comandoOK("AT+CMGF=1", 5000UL)) {
    Serial.println(F("Error configurando modo SMS."));
    return false;
  }

  vaciarEntradaSIM();

  sim800.print(F("AT+CMGS=\""));
  sim800.print(NUMERO_TELEFONO);
  sim800.println(F("\""));

  if (!esperarRespuesta(">", 8000UL)) {
    Serial.println(F("No se recibio el prompt del SMS."));
    return false;
  }

  sim800.print(F(
    "ALERTA: POSIBLE FUGA DE GAS. "
    "El sensor MQ-6 supero el umbral configurado. "
    "Verifique la situacion y actue con precaucion."
  ));

  sim800.write(26); // CTRL+Z: solicita enviar el SMS

  if (esperarRespuesta("+CMGS:", 30000UL)) {
    Serial.println(
      F("El modulo confirmo que el SMS fue aceptado por la red.")
    );
    return true;
  }

  Serial.println(
    F("No se confirmo el envio del SMS.")
  );
  return false;
}

void setup() {
  pinMode(LED_ALERTA, OUTPUT);
  digitalWrite(LED_ALERTA, LOW);

  Serial.begin(9600);
  sim800.begin(9600);

  Serial.println(F("Detector MQ-6 + SIM800L"));
  delay(3000);

  bool responde = false;

  // Intenta comprobar la comunicacion con el modulo.
  for (byte i = 0; i < 5; i++) {
    if (comandoOK("AT", 1500UL)) {
      responde = true;
      break;
    }
    delay(500);
  }

  if (responde) {
    Serial.println(F("SIM800L responde."));
  } else {
    Serial.println(
      F("Sin respuesta del SIM800L. Revisar conexiones y alimentacion.")
    );
  }

  Serial.println(F("Espera inicial del sensor MQ-6..."));
  delay(CALENTAMIENTO_INICIAL);

  Serial.println(
    F("Inicio de lecturas. La espera no sustituye calibracion.")
  );
}

void loop() {
  int lectura = analogRead(SENSOR_GAS);

  Serial.print(F("Lectura MQ-6: "));
  Serial.println(lectura);

  if (lectura >= UMBRAL_ACTIVACION) {
    contandoNormal = false;

    if (!alarmaActiva) {
      alarmaActiva = true;
      smsConfirmado = false;
      huboIntentoSMS = false;

      digitalWrite(LED_ALERTA, HIGH);

      Serial.println(
        F("ALERTA: posible presencia de gas.")
      );
    }

    // Reintenta el SMS si falla y la alarma persiste.
    if (!smsConfirmado &&
        (!huboIntentoSMS ||
         millis() - ultimoIntentoSMS >= INTERVALO_REINTENTO)) {

      huboIntentoSMS = true;
      ultimoIntentoSMS = millis();

      smsConfirmado = enviarSMS();
    }

  } else if (alarmaActiva) {

    if (lectura <= UMBRAL_REARME) {
      if (!contandoNormal) {
        contandoNormal = true;
        inicioNormal = millis();
      }

      if (millis() - inicioNormal >= TIEMPO_REARME) {
        alarmaActiva = false;
        contandoNormal = false;
        smsConfirmado = false;
        huboIntentoSMS = false;

        digitalWrite(LED_ALERTA, LOW);

        Serial.println(
          F("Lectura normal sostenida. Sistema rearmado.")
        );
      }
    } else {
      // Entre ambos umbrales, mantener la alarma activa.
      contandoNormal = false;
    }
  }

  digitalWrite(
    LED_ALERTA,
    alarmaActiva ? HIGH : LOW
  );

  delay(500);
}



